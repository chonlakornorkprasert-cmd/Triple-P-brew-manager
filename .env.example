PORT=3000

# Lightweight local dev database (default; no Docker or PostgreSQL install)
DB_DRIVER=pglite
PGLITE_DATA_DIR=.data/pglite

# External PostgreSQL (use instead of the two lines above)
# DB_DRIVER=postgres
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/triple_p_brew

# Cloud Run + Cloud SQL (use DB_DRIVER=postgres)
# INSTANCE_UNIX_SOCKET=/cloudsql/PROJECT_ID:asia-southeast1:triple-p-db
# DB_USER=triple_p_app
# DB_PASSWORD=store-in-secret-manager
# DB_NAME=triple_p_brew
# DB_POOL_MAX=5
